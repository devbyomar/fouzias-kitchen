# --- Application ---
# Public site URL (no trailing slash). Used by Stripe success/cancel URLs and emails.
SITE_URL=http://localhost:3000

# --- Database (Neon Postgres recommended, any Postgres works) ---
# Format: postgres://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# --- Auth (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# The single email address allowed to sign into /admin. Comma-separated for additional staff.
OWNER_EMAIL=owner@fouziaskitchen.com
# NextAuth v5 trusts host by default in dev; set to true if behind a reverse proxy.
AUTH_TRUST_HOST=true

# --- Email (Resend) ---
# Get from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender. Must be on a domain you've verified in Resend.
EMAIL_FROM="Fouzia's Kitchen <hello@fouziaskitchen.com>"

# --- Stripe ---
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# Local: from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Production: from the webhook endpoint you create in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_
# Set to "true" once HST registration is complete and Stripe Tax is configured.
STRIPE_TAX_ENABLED=false

# --- Rate limiting (Upstash Redis) ---
# Optional in dev; required in production for /api/checkout protection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- File storage (Vercel Blob) ---
# Auto-injected on Vercel; set manually for local uploads.
BLOB_READ_WRITE_TOKEN=
